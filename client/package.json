{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^5.11.16",
    "@mui/lab": "^5.0.0-alpha.128",
    "@mui/material": "^5.12.2",
    "@tanstack/react-query": "^4.29.5",
    "@tanstack/react-query-devtools": "^4.29.6",
    "autosuggest-highlight": "^3.3.4",
    "dayjs": "1.9.4",
    "eslint-plugin-unused-imports": "^2.0.0",
    "graphql": "15.3.0",
    "graphql-request": "^6.0.0",
    "jotai": "^2.0.4",
    "mapbox-gl": "2.14.1",
    "notistack": "^3.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hotkeys-hook": "^3.4.7",
    "react-map-gl": "7.0.23",
    "react-router-dom": "^6.10.0",
    "react-scripts": "^5.0.1",
    "typescript": "4.5",
    "worker-loader": "3.0.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "TZ=UTC react-scripts test",
    "eject": "react-scripts eject",
    "coverage": "TZ=UTC CI=true react-scripts test --coverage",
    "test:ci": "npm run lint && CI=true react-scripts test --coverage",
    "lint": "eslint -c .eslintrc.json 'src/**/*.tsx'",
    "lint:fix": "eslint -c .eslintrc.json 'src/**/*.tsx' --fix",
    "generate": "graphql-codegen",
    "analyze_bundle": "npx source-map-explorer 'build/static/js/*.js'"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not safari < 10",
      "not chrome < 51",
      "not android < 5",
      "not ie < 12"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "not ie 11"
    ]
  },
  "devDependencies": {
    "@graphql-codegen/cli": "3.3.1",
    "@graphql-codegen/client-preset": "^3.0.1",
    "@graphql-codegen/near-operation-file-preset": "1.17.11",
    "@graphql-codegen/typescript": "1.17.11",
    "@graphql-codegen/typescript-operations": "1.17.8",
    "@graphql-codegen/typescript-react-query": "^4.1.0",
    "@testing-library/jest-dom": "5.11.4",
    "@testing-library/react": "^14.0.0",
    "@types/autosuggest-highlight": "^3.2.0",
    "@types/classnames": "2.2.11",
    "@types/jest": "26.0.15",
    "@types/node": "10.17.18",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.1",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@welldone-software/why-did-you-render": "4.3.2",
    "eslint-config-prettier": "6.11.0",
    "eslint-config-react": "1.1.7",
    "eslint-plugin-prettier": "3.1.4",
    "husky": "4.3.0",
    "lint-staged": "10.4.2",
    "mockdate": "3.0.2",
    "prettier": "2.1.1"
  },
  "proxy": "http://localhost:5001",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{tsx,ts,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/interfaces/**",
      "!src/mockData/**",
      "!src/schemas/**",
      "!src/stories/**",
      "!src/serviceWorker.ts",
      "!src/react-app-env.d.ts"
    ]
  }
}
