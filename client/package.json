{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@material-ui/core": "4.11.0",
    "@material-ui/icons": "4.9.1",
    "@material-ui/lab": "4.0.0-alpha.56",
    "classnames": "2.2.6",
    "dayjs": "1.9.4",
    "graphql": "15.3.0",
    "lodash.isequal": "4.5.0",
    "notistack": "1.0.1",
    "react": "16.13.1",
    "react-dom": "16.13.1",
    "react-map-gl": "5.2.10",
    "react-scripts": "4.0.0",
    "typescript": "4.0.2"
  },
  "scripts": {
    "prestart": "npm run generate",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "TZ=UTC react-scripts test",
    "eject": "react-scripts eject",
    "coverage": "TZ=UTC CI=true react-scripts test --coverage",
    "test:ci": "npm run lint && CI=true react-scripts test --coverage",
    "lint": "eslint -c .eslintrc.json 'src/**/*.tsx'",
    "lint:fix": "eslint -c .eslintrc.json 'src/**/*.tsx' --fix",
    "generate": "graphql-codegen",
    "analyze_bundle": "npx source-map-explorer 'build/static/js/*.js'",
    "storybook": "start-storybook -p 9009 -s public",
    "build-storybook": "build-storybook -s public"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@apollo/client": "3.2.5",
    "@graphql-codegen/cli": "1.18.0",
    "@graphql-codegen/near-operation-file-preset": "1.17.11",
    "@graphql-codegen/typescript": "1.17.11",
    "@graphql-codegen/typescript-operations": "1.17.8",
    "@graphql-codegen/typescript-react-apollo": "2.0.7",
    "@storybook/addon-essentials": "6.1.7",
    "@storybook/addons": "6.1.7",
    "@storybook/preset-create-react-app": "3.1.4",
    "@storybook/react": "6.1.7",
    "@testing-library/jest-dom": "5.11.4",
    "@testing-library/react": "10.4.8",
    "@types/classnames": "2.2.11",
    "@types/jest": "26.0.15",
    "@types/lodash.isequal": "4.5.5",
    "@types/node": "10.17.18",
    "@types/react": "16.9.53",
    "@types/react-dom": "16.9.8",
    "@types/react-map-gl": "5.2.9",
    "@typescript-eslint/eslint-plugin": "4.7.0",
    "@typescript-eslint/parser": "4.7.0",
    "@welldone-software/why-did-you-render": "4.3.2",
    "eslint-config-prettier": "6.11.0",
    "eslint-config-react": "1.1.7",
    "eslint-plugin-prettier": "3.1.4",
    "husky": "4.3.0",
    "lint-staged": "10.4.2",
    "mockdate": "3.0.2",
    "prettier": "2.1.1"
  },
  "proxy": "http://localhost:5000",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{tsx,ts,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/interfaces/**",
      "!src/mockData/**",
      "!src/schemas/**",
      "!src/stories/**",
      "!src/serviceWorker.ts",
      "!src/react-app-env.d.ts"
    ]
  }
}
