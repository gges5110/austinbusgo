{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tanstack/react-query": "^4.29.5",
    "autosuggest-highlight": "^3.3.4",
    "dayjs": "1.9.4",
    "gtfs-realtime-bindings": "^1.1.1",
    "jotai": "^2.0.4",
    "mapbox-gl": "^3.26.0",
    "notistack": "^3.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-error-boundary": "^6.0.0",
    "react-map-gl": "8.1.0",
    "react-router-dom": "^6.10.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "TZ=UTC vitest test",
    "serve": "vite preview",
    "coverage": "TZ=UTC CI=true vite vitest --coverage",
    "test:ci": "npm run lint && CI=true vite test --coverage",
    "lint": "eslint -c .eslintrc.json 'src/**/*.{tsx,ts,js}'",
    "lint:fix": "eslint -c .eslintrc.json 'src/**/*.{tsx,ts,js}' --fix",
    "format": "prettier --write 'src/**/*.{tsx,ts,js,json,css,md}'",
    "format:check": "prettier --check 'src/**/*.{tsx,ts,js,json,css,md}'",
    "generate": "cd .. && venv/bin/python -m server.export_openapi > client/openapi.json && cd client && orval --config orval.config.ts",
    "analyze_bundle": "npx source-map-explorer 'build/static/js/*.js'",
    "typecheck": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not safari < 10",
      "not chrome < 51",
      "not android < 5",
      "not ie < 12"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "not ie 11"
    ]
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^4.29.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/autosuggest-highlight": "^3.2.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.10.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.11.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^22.0.0",
    "lint-staged": "10.4.2",
    "orval": "^8.21.0",
    "prettier": "3.9.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "proxy": "http://localhost:5001",
  "lint-staged": {
    "*.{tsx,ts,json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/interfaces/**",
      "!src/mockData/**",
      "!src/schemas/**",
      "!src/stories/**",
      "!src/serviceWorker.ts",
      "!src/react-app-env.d.ts"
    ]
  }
}
