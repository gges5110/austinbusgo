{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^6.5.0",
    "@mui/lab": "^6.0.0-beta.14",
    "@mui/material": "^6.5.0",
    "@tanstack/react-query": "^4.29.5",
    "@tanstack/react-query-devtools": "^4.29.6",
    "autosuggest-highlight": "^3.3.4",
    "dayjs": "1.9.4",
    "eslint-plugin-unused-imports": "^2.0.0",
    "graphql": "^16.11.0",
    "graphql-request": "^6.0.0",
    "jotai": "^2.0.4",
    "mapbox-gl": "^3.5.0",
    "notistack": "^3.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-error-boundary": "^6.0.0",
    "react-hotkeys-hook": "^3.4.7",
    "react-map-gl": "8.1.0",
    "react-router-dom": "^6.10.0",
    "typescript": "4.5"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "TZ=UTC vitest test",
    "serve": "vite preview",
    "coverage": "TZ=UTC CI=true vite vitest --coverage",
    "test:ci": "npm run lint && CI=true vite test --coverage",
    "lint": "eslint -c .eslintrc.json 'src/**/*.{tsx,ts,js}'",
    "lint:fix": "eslint -c .eslintrc.json 'src/**/*.{tsx,ts,js}' --fix",
    "generate": "graphql-codegen",
    "analyze_bundle": "npx source-map-explorer 'build/static/js/*.js'"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not safari < 10",
      "not chrome < 51",
      "not android < 5",
      "not ie < 12"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "not ie 11"
    ]
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.1",
    "@graphql-codegen/client-preset": "^5.1.0",
    "@graphql-codegen/near-operation-file-preset": "^3.1.0",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-codegen/typescript-react-query": "^6.1.1",
    "@testing-library/jest-dom": "5.11.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/autosuggest-highlight": "^3.2.0",
    "@types/jest": "26.0.15",
    "@types/node": "20.2.1",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.1",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@welldone-software/why-did-you-render": "4.3.2",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "6.11.0",
    "eslint-config-react": "1.1.7",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "3.1.4",
    "husky": "4.3.8",
    "jsdom": "^22.0.0",
    "lint-staged": "10.4.2",
    "mockdate": "3.0.2",
    "prettier": "2.1.1",
    "rollup-plugin-copy": "^3.5.0",
    "vite": "^6.0.6",
    "vitest": "4.0.3"
  },
  "proxy": "http://localhost:5001",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{tsx,ts,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/interfaces/**",
      "!src/mockData/**",
      "!src/schemas/**",
      "!src/stories/**",
      "!src/serviceWorker.ts",
      "!src/react-app-env.d.ts"
    ]
  }
}
