#!/bin/bash
# Pre-commit hook: Python linting with black and frontend formatting with lint-staged

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- Python: black ---
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')

if [ -n "$STAGED_PY_FILES" ]; then
    echo "Running black --check on staged Python files..."

    if [ -f "$REPO_ROOT/venv/bin/activate" ]; then
        "$REPO_ROOT/venv/bin/python" -m black --check --verbose $STAGED_PY_FILES
        if [ $? -ne 0 ]; then
            echo ""
            echo "❌ Black formatting check failed!"
            echo "Please run 'make lint' to format your Python files before committing."
            echo ""
            exit 1
        fi
        echo "✅ Black formatting check passed!"
    else
        echo "⚠️  Warning: venv not found at $REPO_ROOT/venv. Skipping black check."
        echo "   Run 'make venv && make deps' to set up the Python environment."
    fi
fi

# --- Frontend: lint-staged ---
STAGED_FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx|ts|json|md)$')

if [ -n "$STAGED_FRONTEND_FILES" ]; then
    echo "Running lint-staged on staged frontend files..."
    cd "$REPO_ROOT/client" && npx --no-install lint-staged
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ lint-staged check failed!"
        echo ""
        exit 1
    fi
fi

exit 0
