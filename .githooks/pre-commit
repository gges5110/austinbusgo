#!/bin/bash
# Pre-commit hook for Python linting with black

# Get repository root
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Get list of staged Python files
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')

if [ -z "$STAGED_PY_FILES" ]; then
    # No Python files staged, exit successfully
    exit 0
fi

echo "Running black --check on staged Python files..."

# Check if virtual environment exists
if [ -f "$REPO_ROOT/venv/bin/activate" ]; then
    # Use black from virtual environment
    PYTHON_BIN="$REPO_ROOT/venv/bin/python"

    # Run black check on staged files
    $PYTHON_BIN -m black --check --verbose $STAGED_PY_FILES
    BLACK_EXIT_CODE=$?

    if [ $BLACK_EXIT_CODE -ne 0 ]; then
        echo ""
        echo "❌ Black formatting check failed!"
        echo "Please run 'make lint' to format your Python files before committing."
        echo ""
        exit 1
    fi

    echo "✅ Black formatting check passed!"
else
    echo "⚠️  Warning: venv not found at $REPO_ROOT/venv. Skipping black check."
    echo "   Run 'make venv && make deps' to set up the Python environment."
fi

exit 0
